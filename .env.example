# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your keys never end up on GitHub.

# The plan you pay for, in Mbps
PROMISED_DOWN=150
PROMISED_UP=10

# Your provider's X handle, e.g. @MTNNG
ISP_HANDLE=@YourISP

# Complain when speed drops below this share of the plan (0.8 = 80%)
TOLERANCE=0.8

# Only needed for:  python main.py --post api
# Create keys with write access at https://developer.x.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: use your own chromedriver / Chrome instead of the automatic one
# CHROMEDRIVER_PATH=C:/path/to/chromedriver.exe
# CHROME_BINARY=C:/Program Files/Google/Chrome/Application/chrome.exe
